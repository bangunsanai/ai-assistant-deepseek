# ============================================
# KONFIGURASI API KEY
# ============================================
# Dapatkan API Key dari penyedia layanan AI yang kompatibel dengan OpenAI API.
# Masukkan key Anda di bawah ini (format: sk-xxx...)

API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# BASE URL (ENDPOINT API)
# ============================================
# Isi dengan endpoint dari penyedia layanan Anda.
# Contoh:
# - https://api.openai.com/v1
# - https://api.your-provider.com/v1

BASE_URL=https://api.your-provider.com/v1

# ============================================
# NAMA MODEL (OPSIONAL)
# ============================================
# Default: deepseek-chat
# Ganti sesuai model yang tersedia di provider Anda.

MODEL_NAME=deepseek-chat
